---
import Icon from '../../ui/icons/Icon.astro'

const { content, author, role, avatarSrc } = Astro.props

interface Props {
	content: string
	author: string
	role: string
	avatarSrc: string
}
---

<blockquote class="relative">
	<Icon name="quotation" />

	<div class="relative z-10">
		<p class="text-xl italic text-content-text-secondary dark:text-content-text-muted">
			{content}
		</p>
	</div>

	<div class="mt-6">
		<div class="flex items-center">
			<div class="flex-shrink-0">
				<img
					class="h-8 w-8 rounded-full"
					src={avatarSrc}
					alt="Avatar Description"
					draggable="false"
					loading="eager"
				/>
			</div>
			<div class="ms-4 grow">
				<div class="font-bold text-content-text-secondary dark:text-content-text-muted">
					{author}
				</div>
				<div class="text-content-text-tertiary">{role}</div>
			</div>
		</div>
	</div>
</blockquote>
