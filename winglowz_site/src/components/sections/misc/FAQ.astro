---
import { getLangFromUrl, useTranslations } from '@/utils/i18n'
import AccordionItem from '@components/ui/blocks/AccordionItem.astro'

const lang = getLangFromUrl(Astro.url)
const t = await useTranslations(lang, 'faq')

interface Props {
  title?: string
}

interface FAQItem {
  question: string
  answer: string
}

const { title = t.title } = Astro.props
const items = (t.items ?? []) as FAQItem[]
---

<div class="landing-section site-page-shell mx-auto py-8 sm:py-10 lg:py-14">
  <div class="site-section-header mx-auto max-w-2xl text-center">
    <h2 class="landing-section-title text-content-text-secondary dark:text-content-text-muted" set:html={title} />
  </div>

  <div class="mx-auto max-w-2xl">
    <div class="hs-accordion-group">
      {
        items.map((item: FAQItem, index: number) => (
          <AccordionItem
            id={`hs-basic-with-title-and-arrow-stretched-heading-${index + 1}`}
            collapseId={`hs-basic-with-title-and-arrow-stretched-collapse-${index + 1}`}
            question={item.question}
            answer={item.answer}
            first={index === 0}
          />
        ))
      }
    </div>
  </div>
</div>
