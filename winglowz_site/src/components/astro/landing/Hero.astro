---
/* Hero section — pure Astro, CSS animations replace framer-motion */
import Button from '@/components/Button.astro'
import LogoMarquee from '@/components/astro/landing/LogoMarquee.astro'
import { testimonialPeople } from '@/data/testimonialPeople'
import { getLangFromUrl } from '@/utils/i18n'
import { getLocalizedPath } from '@/utils/routing'

const lang = getLangFromUrl(Astro.url)
const windowsMasteryUrl = lang === 'fr' ? '/fr/maitrise-windows' : '/windows-mastery'
const testimonialsUrl = getLocalizedPath(lang, 'recommendations')

const stats = lang === 'fr'
  ? [
      { value: "8", label: "modules" },
      { value: "2", label: "langues" },
      { value: "3", label: "piliers de parcours" },
    ]
  : [
      { value: "8", label: "modules" },
      { value: "2", label: "languages" },
      { value: "3", label: "core tracks" },
    ]

const heroText = lang === 'fr'
  ? {
      badge: "Formation Windows & outils de workflow",
      h1Line1: "Moins de friction.",
      h1Line2: "Plus de travail utile.",
      sub: "WinGlows vous aide à reprendre le contrôle d’un environnement Windows trop bruyant, trop fragmenté et trop fatigant. Le premier pas reste la page dédiée à la formation.",
      cta: "Voir la formation Windows",
      testimonials: "Témoignages",
      reviewsLabel: 'Avis',
      reviews: "issues de la communauté",
    }
  : {
      badge: "Windows training & workflow tools",
      h1Line1: "Less friction.",
      h1Line2: "More real work.",
      sub: "WinGlows helps you regain control over a Windows environment that is too noisy, too fragmented, and too tiring. Start from the dedicated Windows course path.",
      cta: "See the Windows course",
      testimonials: "Testimonials",
      reviewsLabel: 'Reviews',
      reviews: "from community feedback",
    }
---

<section class="landing-hero-shell relative flex flex-col items-center justify-center overflow-hidden bg-content-bg-secondary px-4 dark:bg-black">
  <!-- Background gradient -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-content-bg-secondary via-white to-content-bg-secondary dark:from-black dark:via-black dark:to-black"></div>

  <!-- Subtle radial glow -->
  <div class="landing-hero-glow pointer-events-none absolute left-1/2 -translate-x-1/2 rounded-full bg-fuchsia-400/10 blur-3xl dark:bg-content-text-secondary/20"></div>

  <div class="relative z-10 w-full min-w-0 max-w-5xl mx-auto text-center">
    <!-- Badge -->
    <div class="landing-hero-fade landing-hero-fade--badge landing-hero-badge landing-surface hidden items-center landing-badge rounded-full border px-4 py-2 md:inline-flex">
      <span class="landing-hero-status-dot pulse-glow h-2 w-2 rounded-full"></span>
      <span class="text-sm text-content-text-secondary dark:text-content-text-tertiary">{heroText.badge}</span>
    </div>

    <!-- Headline with text mask animation -->
    <h1 class="landing-hero-title text-5xl font-bold leading-[0.98] tracking-tight text-content-text-primary dark:text-content-text-primary sm:text-8xl lg:text-9xl">
      <span class="block overflow-hidden">
        <span class="landing-hero-text-line landing-hero-text-line--primary block">
          {heroText.h1Line1}
        </span>
      </span>
      <span class="block overflow-hidden">
        <span class="landing-hero-text-line landing-hero-text-line--secondary block text-content-text-muted dark:text-content-text-tertiary">
          {heroText.h1Line2}
        </span>
      </span>
    </h1>

    <!-- Subheadline -->
    <p class="landing-hero-fade landing-hero-fade--copy landing-hero-copy mx-auto max-w-2xl text-lg leading-relaxed text-content-text-secondary dark:text-content-text-tertiary sm:text-xl">
      {heroText.sub}
    </p>

    <!-- CTAs -->
    <div class="landing-hero-fade landing-hero-fade--actions landing-hero-actions flex flex-col items-center justify-center sm:flex-row">
      <Button variant="primary" link={windowsMasteryUrl} track="hero-primary-cta" icon={{ type: 'icon', name: 'arrow-right' }}>
        {heroText.cta}
      </Button>
      <Button variant="secondary" link={testimonialsUrl} track="hero-recommendations-cta">
        {lang === 'fr' ? 'Recommandations' : 'Recommendations'}
      </Button>
    </div>

    <!-- Social Proof Avatars -->
    <a
      href="#testimonials"
      aria-label={lang === 'fr' ? 'Voir les témoignages de la communauté' : 'View community testimonials'}
      class="landing-hero-fade landing-hero-fade--proof landing-hero-proof flex flex-col items-center rounded-lg focus-visible:ring focus-visible:ring-ring focus-visible:ring-offset-2 dark:focus-visible:ring-offset-black"
    >
      <div class="flex items-center -space-x-3">
        {testimonialPeople.map((person) => (
          <div class="landing-hero-avatar relative">
            {person.avatarRepresentation === 'appsumo-generic' ? (
              <span
                aria-hidden="true"
                class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-white bg-content-bg-secondary text-xs font-bold text-content-text-primary dark:border-black dark:bg-content-bg-secondary dark:text-content-text-primary"
              >
                {person.name[0]}
              </span>
            ) : (
              <img
                src={person.avatarSrc}
                alt=""
                class="h-10 w-10 rounded-full border-2 border-white object-cover dark:border-black"
                loading="eager"
              />
            )}
          </div>
        ))}
      </div>
      <p class="text-sm text-content-text-muted dark:text-content-text-tertiary">
        <span class="font-medium text-content-text-primary dark:text-content-text-primary">{heroText.reviewsLabel}</span> {heroText.reviews}
      </p>
    </a>

    <div class="landing-testimonials-bleed">
      <LogoMarquee embedded />
    </div>

    <!-- Stats -->
    <div class="landing-hero-fade landing-hero-fade--stats landing-hero-stats mx-auto grid max-w-2xl grid-cols-2 sm:grid-cols-4">
      {stats.map((stat) => (
        <div class="landing-hero-stat relative text-center">
          <div class="text-2xl font-bold text-content-text-primary dark:text-content-text-primary sm:text-3xl">{stat.value}</div>
          <div class="landing-hero-stat-label text-xs text-content-text-muted dark:text-content-text-tertiary sm:text-sm">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .landing-hero-shell {
    padding-top: var(--landing-hero-shell-padding-top);
  }

  .landing-hero-glow {
    width: var(--landing-hero-glow-width);
    height: var(--landing-hero-glow-height);
    top: var(--landing-hero-glow-top);
  }

  .landing-hero-status-dot {
    background-color: var(--brand-green);
  }

  .landing-hero-text-line {
    opacity: 0;
    transform: translateY(100%);
    animation: hero-text-reveal var(--landing-hero-text-duration) var(--landing-hero-ease) forwards;
  }

  .landing-hero-text-line--secondary {
    animation-delay: var(--landing-hero-title-secondary-delay);
  }

  .landing-hero-fade {
    opacity: 0;
    transform: translateY(20px);
    animation: hero-fade-up var(--landing-hero-fade-duration) var(--landing-hero-ease) forwards;
  }

  .landing-hero-fade--badge {
    animation-delay: var(--landing-hero-badge-delay);
  }

  .landing-hero-fade--copy {
    animation-delay: var(--landing-hero-copy-delay);
  }

  .landing-hero-fade--actions {
    animation-delay: var(--landing-hero-actions-delay);
  }

  .landing-hero-fade--proof {
    animation-delay: var(--landing-hero-proof-delay);
  }

  .landing-hero-fade--stats {
    animation-delay: var(--landing-hero-stats-delay);
  }

  .landing-hero-avatar {
    opacity: 0;
    transform: scale(0.5) translateX(-20px);
    animation: avatar-pop var(--landing-hero-avatar-duration) var(--landing-hero-ease) forwards;
  }

  .landing-hero-stat {
    opacity: 0;
    transform: scale(0.8);
    animation: hero-fade-up var(--landing-hero-stat-duration) var(--landing-hero-ease) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .landing-hero-text-line,
    .landing-hero-fade,
    .landing-hero-avatar,
    .landing-hero-stat {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
