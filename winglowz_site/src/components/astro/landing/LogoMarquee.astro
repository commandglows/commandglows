---
/* LogoMarquee — Astro wrapper with TestimonialCarousel React island */
import { TestimonialCarousel } from '@components/react/landing/TestimonialCarousel'
import { getLangFromUrl } from '@/utils/i18n'

interface Props {
  embedded?: boolean
}

const { embedded = false } = Astro.props
const lang = getLangFromUrl(Astro.url)

const tools = [
  { name: "ObsiFlowz" },
  { name: "ReplayGlowz" },
  { name: "RSSFlowz" },
  { name: "PluginFlowz" },
  { name: "Windows Mastery" },
  { name: "Obsidian" },
  { name: "Chrome" },
  { name: "WinGlows" },
]

---

  <section
  id="testimonials"
  class:list={[
    embedded ? 'landing-testimonials--embedded scroll-mt-20 overflow-hidden' : 'landing-testimonials-shell scroll-mt-20 overflow-hidden',
    embedded ? 'bg-transparent' : 'bg-content-bg-subtle dark:bg-content-bg-inverse',
  ]}
>
  <!-- Testimonials carousel (React island) -->
  <div class="landing-testimonials-carousel reveal delay-2 max-w-3xl mx-auto px-4">
    <TestimonialCarousel client:only="react" lang={lang} />
  </div>

  <!-- Marquee -->
  <div class="landing-testimonials-marquee relative">
    <div class="landing-marquee-fade-left pointer-events-none absolute bottom-0 left-0 top-0 z-10 w-32"></div>
    <div class="landing-marquee-fade-right pointer-events-none absolute bottom-0 right-0 top-0 z-10 w-32"></div>

    <div class="flex animate-marquee">
      {[...tools, ...tools].map((tool) => (
        <div
          class="mx-8 flex h-16 items-center justify-center grayscale opacity-50 transition-all duration-300 hover:grayscale-0 hover:opacity-100"
          style="min-width: var(--logo-marquee-item-min-width);"
        >
          <div class="landing-badge flex items-center text-content-text-secondary dark:text-content-text-tertiary">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-content-bg-subtle dark:bg-content-bg-strong">
              <span class="text-xs font-bold">{tool.name[0]}</span>
            </div>
            <span class="font-medium">{tool.name}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .landing-testimonials--embedded {
    padding-top: var(--landing-testimonials-embedded-padding-top);
    padding-bottom: var(--landing-testimonials-embedded-padding-bottom);
  }
</style>
