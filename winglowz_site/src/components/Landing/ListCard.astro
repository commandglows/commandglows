---
import Card from './Card.astro';
export type Props = Parameters<typeof Card>[0];
---

<Card {...Astro.props}>
	<div class="landing-list-card">
		<slot />
	</div>
</Card>

<style>
	.landing-list-card :global(ul) {
		list-style-type: none;
		padding: 0;
	}

	.landing-list-card :global(li) {
		border-bottom: 1px solid var(--landing-list-divider);
		padding: var(--landing-list-item-padding);
		margin: 0 !important;
	}
	.landing-list-card :global(li:last-child) {
		border-bottom: none;
	}

	.landing-list-card :global(a) {
		display: flex;
		gap: var(--landing-list-gap);
		justify-content: space-between;
		align-items: center;
		text-decoration: none;
	}
</style>
