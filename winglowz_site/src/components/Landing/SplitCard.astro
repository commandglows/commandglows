---
interface Props {
	title?: string;
	icon?: string;
	href?: string;
}
---

<div class="landing-card-shell card--fullwidth">
	<article class="card">
		<div class="landing-card-shell__split split">
			<slot />
		</div>
	</article>
</div>

<style>
	.card--fullwidth {
		grid-column: 1 / -1;
	}
	:global(:root[data-theme='light']) .card--fullwidth {
		--card-bg: hsl(var(--landing-card));
	}

	.card--fullwidth .card {
		background:
			radial-gradient(var(--brand-cyan), transparent 70%) no-repeat 50% -25% / 120% 300%,
			var(--card-bg, hsl(var(--landing-card)));
	}

	@screen 2xl {
		.landing-card-shell__split {
			flex-direction: row;
		}
	}
</style>
