---
interface Props {
	title?: string;
	icon?: string;
	href?: string;
}
---

<div class="landing-card-shell landing-card">
	<article class="landing-card-shell__panel card">
		<slot />
	</article>
</div>

<style>
	.landing-card {
		display: contents;
	}
	:global(:root[data-theme='light']) .landing-card {
		--card-bg: hsl(var(--landing-card));
	}

	.landing-card:nth-child(2n) .card {
		--landing-card-accent: var(--brand-red);
	}
</style>
