---
// Import all required components and utilities
import type { CollectionEntry } from 'astro:content'
import AvatarBlogLarge from '@components/ui/avatars/AvatarBlogLarge.astro'
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro'

const { blogEntry, blogLocale = '' } = Astro.props
const blogSlug = blogEntry.id.replace(/^fr\//, '').replace(/^en\//, '').replace(/\.md$/, '')

interface Props {
	blogEntry: CollectionEntry<'blog'>
	blogLocale?: string
}
---

<!-- Root container, which is divided into 2 grid column layout for larger screens -->
<div class="grid gap-8 sm:grid-cols-2 sm:items-center">
	<!-- Container for the blog post's cover image -->
	<div class="sm:order-2">
		<div class="card-blog-recent-media relative rounded-lg">
			<img
				class="absolute start-0 top-0 size-full rounded-xl object-cover"
				src={blogEntry.data.cardImage.toString()}
				alt={blogEntry.data.cardImageAlt}
				draggable="false"
				loading="eager"
			/>
		</div>
	</div>
	<!-- Container for the blog post's heading, author avatar, author's role, and read more button -->
	<div class="sm:order-1">
		<!-- Blog title which is also a hyperlink to the blog detail page  -->
		<h2
			class="text-balance text-2xl font-bold tracking-tight text-content-text-primary dark:text-content-text-primary md:text-3xl lg:text-4xl lg:leading-tight xl:text-5xl xl:leading-tight"
		>
			<a
				class="outline-none ring-content-text-secondary/50 transition duration-300 hover:text-magenta focus-visible:ring dark:text-content-text-secondary dark:ring-content-text-secondary/50 dark:hover:text-content-text-primary dark:focus:outline-none"
				href={blogLocale === 'fr'
					? `/fr/blog/${blogSlug}`
					: `/blog/${blogSlug}`}
				data-astro-prefetch
			>
				{blogEntry.data.description}
			</a>
		</h2>
		<!-- Container for the author's avatar and metadata -->
		<div class="mt-6 flex items-center sm:mt-10">
			<AvatarBlogLarge post={blogEntry} />

			<div class="ms-3 sm:ms-4">
				<p class="font-bold text-content-text-primary dark:text-content-text-primary sm:mb-1">
					{blogEntry.data.author}
				</p>
				<p class="text-content-text-muted">
					{blogEntry.data.role}
				</p>
			</div>
		</div>
		<!-- Read More button which is a link to the blog post detailed page -->
		<div class="mt-5">
			<PrimaryCTA
				url={blogLocale && blogLocale !== 'en'
					? `/${blogLocale}/blog/${blogSlug}/`
					: `/blog/${blogSlug}/`}
				title="Read More"
				data-astro-prefetch
			/>
		</div>
	</div>
</div>
<style>
	@screen sm {
		.card-blog-recent-media {
			padding-top: var(--media-ratio-card-square);
		}
	}
</style>
