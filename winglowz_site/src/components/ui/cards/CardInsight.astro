---
import Icon from '@components/ui/icons/Icon.astro'

const {
	insightEntry,
	insightLocale,
	label = Astro.currentLocale === 'fr' ? 'Lire plus' : 'Read more',
} = Astro.props

interface Props {
	insightEntry: {
		slug: string
		data: {
			cardImage: string
			cardImageAlt: string
			title: string
			description: string
		}
	}
	insightLocale?: string
	label?: string
}
---

<!-- The anchor tag is the root container for the "Insight" card. It links to the insight detail page. -->
<a
	class="group rounded-xl outline-none ring-content-text-secondary/50 transition duration-300 focus-visible:ring dark:ring-content-text-secondary/50 dark:focus:outline-none"
	href={insightLocale && insightLocale !== 'en'
		? `/${insightLocale}/insights/${insightEntry.slug.replace(/^fr\//, '')}/`
		: `/insights/${insightEntry.slug.replace(/^en\//, '')}/`}
>
	<!-- This is the container for the insight's cover image. -->
	<div class="card-insight-media relative overflow-hidden rounded-xl">
		<img
			class="absolute start-0 top-0 size-full rounded-xl object-cover transition duration-500 ease-in-out group-hover:scale-105"
			src={insightEntry.data.cardImage.toString()}
			alt={insightEntry.data.cardImageAlt}
			draggable="false"
			loading="eager"
		/>
	</div>
	<!-- This is the container for the insight's title and description. -->
	<div class="mt-7">
		<!-- The title of the insight -->
		<h3
			class="text-xl font-bold text-content-text-primary group-hover:text-content-text-secondary dark:text-content-text-primary dark:group-hover:text-content-text-tertiary"
		>
			{insightEntry.data.title}
		</h3>
		<!-- The description of the insight -->
		<p class="mt-3 text-content-text-secondary dark:text-content-text-tertiary">
			{insightEntry.data.description}
		</p>
		<!-- The "Read More" hyperlink going to the full insight. With an arrow icon -->
		<p
			class="mt-5 inline-flex items-center gap-x-1 font-medium text-magenta decoration-2 group-hover:underline dark:text-magenta"
		>
			{label}
			<Icon name="arrowRightStatic" />
		</p>
	</div>
</a>
<style>
	.card-insight-media {
		padding-top: var(--media-ratio-card-wide);
	}

	@media (width >= 40rem) {
		.card-insight-media {
			padding-top: var(--media-ratio-card-insight);
		}
	}
</style>
