---
const { label= Astro.currentLocale === "fr" ? "Numéro de téléphone" : "Phone Number", id } = Astro.props;

interface Props {
  label?: string;
  id: string;
}
---

<div>
  <label for={id} class="sr-only">{label}</label>
  <input
    type="tel"
    name="hs-phone-number"
    id={id}
    class="block w-full rounded-lg border border-content-border bg-content-bg-subtle px-4 py-3 text-content-text-secondary placeholder:text-content-text-muted focus:border-content-border focus:outline-none focus:ring focus:ring-content-border-strong disabled:pointer-events-none disabled:opacity-50 dark:border-content-border-strong dark:bg-content-bg-strong/30 dark:text-content-text-muted dark:placeholder:text-content-text-muted dark:focus:ring-1"
    placeholder={label}
  />
</div>
