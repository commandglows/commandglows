---
const { url } = Astro.props;
interface Props {
  url: string;
}
const linkClass =
  "inline-flex h-10 w-10 items-center justify-center gap-x-2 rounded-lg border border-transparent text-sm font-bold text-content-text-secondary outline-none ring-content-border-strong hover:bg-content-bg-hover focus:outline-none focus-visible:ring focus-visible:ring-content-border-strong dark:ring-content-border-strong dark:hover:bg-content-bg-hover";
---

<a class={linkClass} href={url} target="_blank" rel="noopener noreferrer">
  <slot />
</a>
