---
// Destructure the properties from Astro.props
const { title } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  title: string;
}
// Define CSS classes for styling the button
const baseClasses =
  "inline-flex w-full items-center justify-center gap-x-2 rounded-lg px-4 py-3 font-bold text-content-text-primary focus-visible:ring outline-none transition duration-300";
const borderClasses = "border border-transparent";
const bgColorClasses = "bg-yellow dark:focus:outline-none";
const hoverClasses = "hover:bg-yellow/80";
const disabledClasses = "disabled:pointer-events-none disabled:opacity-50";
const ringClasses = "ring-content-text-secondary/50 dark:ring-content-text-secondary";
---

<!-- Styled submit button with dynamic title -->
<button
  type="submit"
  class={`${baseClasses} ${borderClasses} ${bgColorClasses} ${hoverClasses} ${disabledClasses} ${ringClasses}`}
  >{title}</button
>
