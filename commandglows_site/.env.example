# App
SITE=https://www.commandglows.com
PUBLIC_SITE_URL=https://www.commandglows.com
PUBLIC_CONVEX_URL=https://your-project.convex.cloud
SUITE_API_ALLOWED_ORIGINS=https://www.commandglows.com,https://commandglows.com,https://www.commandglows.com,https://your-commandglows-app-domain.example
PORT=3011

# Firebase Admin (bridge API)
# Option A (recommended): JSON service account string (single-line JSON)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: split service account fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Clerk
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Shared bridge secret between Astro API and Convex
SUITE_BRIDGE_CONVEX_SECRET=your_bridge_secret_here
# Canonical environment forwarded by bridge endpoints and used by Convex filtering.
SUITE_BRIDGE_ENVIRONMENT=development
# ContentGlows Auth0 adapter (server-only except Auth0 domain/audience identifiers)
CONTENTGLOWS_AUTH0_DOMAIN=your-tenant.eu.auth0.com
CONTENTGLOWS_AUTH0_AUDIENCE=https://api.contentglows.com
CONTENTGLOWS_AUTH0_ENTITLEMENT_BRIDGE_SECRET=replace_with_a_distinct_long_random_secret
# HMAC secret used to re-pseudonymize every product trial installation and
# network signal server-side, including client-hashed CommunityGlows signals.
# Required for trial bridges. Keep it stable per environment; never expose it.
SUITE_TRIAL_SIGNAL_SECRET=replace_with_a_long_random_secret
COMMUNITYGLOWS_ACCOUNT_RETENTION_SECRET=replace_with_a_distinct_long_random_secret
# Firebase bridge always enforces revoked/disabled session rejection server-side (no env toggle).
# Optional dedicated secret for internal sync endpoint auth (falls back to SUITE_BRIDGE_CONVEX_SECRET)
SUITE_BRIDGE_SYNC_SECRET=
# Convex webhook runtime URL for Astro internal bridge sync endpoint
SUITE_BRIDGE_SYNC_URL=https://www.commandglows.com/api/bridge/sync
# ReplayGlowz product token signing (RS256, private key PEM PKCS8; escaped newlines accepted)
REPLAYGLOWZ_PRODUCT_JWT_PRIVATE_KEY_PEM=
REPLAYGLOWZ_PRODUCT_JWT_KEY_ID=replayglowz-suite-2026-06-02
# Stable protocol identifier: migrate producers and verifiers together before changing it.
REPLAYGLOWZ_PRODUCT_JWT_ISSUER=https://commandglows.com
REPLAYGLOWZ_PRODUCT_JWT_AUDIENCE=replayglowz-convex
REPLAYGLOWZ_PRODUCT_JWT_PUBLIC_KEY_JWK=
REPLAYGLOWZ_PRODUCT_JWT_PUBLIC_KEY_PEM=

# Stripe Managed Payments (sole suite checkout provider)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional override; the installed Stripe SDK default is used when omitted.
STRIPE_API_VERSION=
STRIPE_COMMANDGLOWS_APP_FOCUS_PRICE_ID=price_xxx
STRIPE_COMMANDGLOWS_APP_POWER_PRICE_ID=price_xxx
STRIPE_COMMANDGLOWS_APP_CONTROL_PRICE_ID=price_xxx
STRIPE_COMMANDGLOWS_APP_COMMAND_PRICE_ID=price_xxx
STRIPE_COMMUNITYGLOWS_LIFETIME_DEAL_PRICE_ID=price_xxx
STRIPE_COMMANDGLOWS_FORMATION_PRICE_ID=price_xxx
# Optional allowlisted founder promotion. The public code defaults to FOUNDER.
STRIPE_COMMANDGLOWS_FOUNDER_DISCOUNT_CODE=FOUNDER
STRIPE_COMMANDGLOWS_FOUNDER_PROMOTION_CODE_ID=promo_xxx
# Dedicated HMAC secret for the short-lived app-to-checkout identity handoff.
SUITE_COMMERCE_CHECKOUT_SECRET=

# Resend
RESEND_API_KEY=re_xxx
RESEND_AUDIENCE_ID=audience_xxx

# Gemini CLI / rewrite + OCR for /temu
GEMINI_API_KEY=
# Optional explicit path if gemini is not on PATH
GEMINI_BIN=
