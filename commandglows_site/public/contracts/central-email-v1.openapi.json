  "info": {
    "title": "CommandGlows central email operations and campaigns",
    "version": "1.0.0",
    "description": "Additive v1 backend contract. Machine credentials stay in authenticated server relays. Existing subscription and one-recipient broadcast APIs are documented separately. No deployed capability or public campaign activation is implied."
