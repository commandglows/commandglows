---
import type { SiteAuth } from '@/lib/auth/siteAuth'
import { isAccountRecoveryAvailable } from '@/lib/auth/accountRecoveryAvailability'

interface Props {
  auth: SiteAuth
  lang: 'en' | 'fr'
}

const { auth, lang } = Astro.props
const isFrench = lang === 'fr'
const recoveryUrl = isFrench ? '/fr/account/link-existing' : '/account/link-existing'
const contactUrl = isFrench ? '/fr/contact' : '/contact'
const recoveryAvailable = isAccountRecoveryAvailable(Astro.url.origin, auth.unavailable)
---

<div class="min-w-0">
  <header class="workspace-page-heading">
    <h1 class="text-dashboard-text-primary text-3xl font-bold">{isFrench ? 'Paramètres du compte' : 'Account settings'}</h1>
    <p class="text-dashboard-text-muted mt-2">{isFrench ? 'Consultez les informations associées à votre connexion.' : 'Review the information associated with your sign-in.'}</p>
  </header>

  {auth.unavailable ? (
    <section class="workspace-card workspace-feature" aria-live="polite">
      <h2 class="text-content-text-primary text-lg font-semibold">{isFrench ? 'Profil temporairement indisponible' : 'Profile temporarily unavailable'}</h2>
      <p class="text-content-text-secondary mt-2">{isFrench ? 'Votre profil n’a pas pu être vérifié. Aucun renseignement de compte n’est affiché.' : 'Your profile could not be verified. No account details are being shown.'}</p>
      <a class="brand-text-magenta mt-4 inline-flex min-h-11 items-center font-semibold underline focus-visible:outline-2 focus-visible:outline-offset-2" href={Astro.url.pathname} data-astro-reload>{isFrench ? 'Réessayer' : 'Try again'}</a>
    </section>
  ) : (
    <section class="workspace-card workspace-feature">
      <h2 class="text-content-text-primary text-lg font-semibold">{isFrench ? 'Profil' : 'Profile'}</h2>
      <dl class="workspace-profile-fields mt-5">
        <div>
          <dt class="text-content-text-tertiary text-sm">{isFrench ? 'Nom' : 'Name'}</dt>
          <dd class="text-content-text-primary mt-1 break-words">{auth.name || (isFrench ? 'Non renseigné' : 'Not provided')}</dd>
        </div>
        <div>
          <dt class="text-content-text-tertiary text-sm">{isFrench ? 'Adresse email' : 'Email address'}</dt>
          <dd class="text-content-text-primary mt-1 break-words">{auth.email || (isFrench ? 'Non renseignée' : 'Not provided')}</dd>
        </div>
      </dl>
      <p class="text-content-text-secondary mt-5 text-sm">{isFrench ? 'Ces informations proviennent de votre connexion. Leur modification n’est pas disponible dans cet espace.' : 'This information comes from your sign-in provider. Editing it is not available here.'}</p>
      {recoveryAvailable ? <a class="dashboard-action-link workspace-button mt-5" href={recoveryUrl}>{isFrench ? 'Retrouver mes achats existants' : 'Recover existing purchases'}</a> : <p class="text-content-text-secondary mt-5">{isFrench ? 'La récupération des achats n’est pas disponible pour le moment. Gardez votre confirmation d’achat et contactez le support si vous avez besoin d’aide.' : 'Purchase recovery is not available right now. Keep your purchase confirmation and contact support if you need help.'} <a class="brand-text-magenta font-semibold underline focus-visible:outline-2 focus-visible:outline-offset-2" href={contactUrl}>{isFrench ? 'Contacter le support' : 'Contact support'}</a></p>}
    </section>
  )}
  {!auth.unavailable && auth.provider === 'clerk' && (
    <section class="workspace-card mt-6">
      <h2 class="text-content-text-primary text-lg font-semibold">{isFrench ? 'Liaison du compte' : 'Link your account'}</h2>
      <p class="text-content-text-secondary mt-2">{isFrench ? 'Reliez ce compte à la nouvelle connexion pour conserver vos achats et vos accès.' : 'Link this account to the new sign-in to keep your purchases and access.'}</p>
      {recoveryAvailable ? (
        <form method="post" action="/api/auth/link" class="mt-4">
          <input type="hidden" name="lang" value={lang} />
          <button type="submit" class="workspace-button">{isFrench ? 'Relier mon compte' : 'Link my account'}</button>
        </form>
      ) : <p class="text-content-text-secondary mt-4">{isFrench ? 'La liaison est temporairement indisponible.' : 'Account linking is temporarily unavailable.'}</p>}
    </section>
  )}
</div>
