---
import { getNavigation } from "../../../utils/fr/navigation";
const navigation = await getNavigation();

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<div class="flex h-screen flex-col justify-between border-r border-dashboard-border bg-dashboard-bg">
  <div class="px-4 py-6">
    <nav aria-label="Main Nav" class="mt-6 flex flex-col space-y-1">
      {
        navigation.dashboard.map((item) => (
          <a
            href={item.href}
            class:list={[
              "flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium",
              currentPath === item.href
                ? "bg-dashboard-bgSubtle text-dashboard-textSecondary"
                : "text-dashboard-textMuted hover:bg-dashboard-bgSubtle hover:text-dashboard-textSecondary",
            ]}
          >
            <Fragment set:html={item.icon} />
            {item.name}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="sticky inset-x-0 bottom-0 border-t border-dashboard-border">
    <a
      href="/dashboard/parametres"
      class="flex items-center gap-2 bg-dashboard-bg p-4 hover:bg-dashboard-bgSubtle"
    >
      <img
        alt="Profile"
        src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix"
        class="h-10 w-10 rounded-full object-cover"
      />

      <div>
        <p class="text-xs">
          <strong class="block font-medium text-dashboard-textPrimary">Compte</strong>
          <span class="text-dashboard-textMuted"> Gérer votre profil </span>
        </p>
      </div>
    </a>
  </div>
</div>
