---
// Extract the properties from Astro.props
const { title, subTitle } = Astro.props;
// Define TypeScript interface for the properties
interface Props {
  title: string;
  subTitle: string;
}
---

<!-- Container for title and subtitle -->
<div>
  <p class="text-3xl font-bold text-magenta dark:text-magenta">{title}</p>
  <p class="mt-1 text-content-text-secondary dark:text-content-text-tertiary">{subTitle}</p>
</div>
