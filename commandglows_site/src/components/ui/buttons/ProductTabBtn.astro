---
// Destructure the properties from Astro.props
const { id, dataTab, title, first } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  id: string;
  dataTab: string;
  title: string;
  first?: boolean;
}
// Define constants for styling classes
const BUTTON_CLASS =
  "flex w-full justify-center rounded-xl border border-transparent p-3 outline-none ring-content-text-secondary/50 transition duration-300 hover:bg-content-bg-secondary focus-visible:ring dark:ring-content-text-secondary dark:hover:bg-content-bg-secondary dark:focus:outline-none md:p-5";

const HEADING_CLASS = "block text-center font-bold";
const INACTIVE_HEADING_CLASS = "text-content-text-primary dark:text-content-text-primary";
---

<!-- Tab button element -->
<button
  type="button"
  class={`${BUTTON_CLASS} ${first ? "active bg-content-bg-secondary hover:border-transparent dark:bg-white/5" : ""}`}
  id={id}
  data-target={dataTab}
  role="tab"
>
  <!-- Tab text -->
  <span
    class={`${HEADING_CLASS} ${first ? "text-magenta dark:text-magenta" : INACTIVE_HEADING_CLASS}`}
  >
    {title}
  </span>
</button>
