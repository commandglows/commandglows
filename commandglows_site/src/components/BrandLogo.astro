---
interface Props {
  class?: string
  style?: string
  title?: string
}

const { class: className, style, title = 'CMDglows' } = Astro.props
---

<svg
  class={className}
  style={style}
  viewBox="0 0 470 140"
  role="img"
  aria-label={title}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="cmdglows-wordmark" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="var(--brand-yellow)" />
      <stop offset="0.38" stop-color="var(--brand-red)" />
      <stop offset="0.66" stop-color="var(--brand-magenta)" />
      <stop offset="1" stop-color="var(--brand-violet)" />
    </linearGradient>
    <filter id="cmdglows-shadow" x="-20%" y="-30%" width="140%" height="170%">
      <feDropShadow dx="0" dy="0" stdDeviation="4" flood-color="var(--brand-magenta)" flood-opacity="0.42" />
    </filter>
  </defs>
  <text
    x="235"
    y="88"
    text-anchor="middle"
    dominant-baseline="middle"
    fill="url(#cmdglows-wordmark)"
    filter="url(#cmdglows-shadow)"
    font-family="Audiowide, Space Grotesk, sans-serif"
    font-size="70"
    font-weight="700"
    letter-spacing="-2"
  >CMDglows</text>
</svg>
