---
// Import AvatarTestimonialSection component for use in this module
import AvatarTestimonialSection from "../../ui/avatars/AvatarTestimonialSection.astro";

// Define props from Astro
const { title, testimonials } = Astro.props;

// Define TypeScript interface for Testimonial
interface Testimonial {
  content: string;
  author: string;
  role: string;
  avatarSrc: string;
  avatarAlt: string;
  footerLink?: string;
}

// Define TypeScript interface for props
interface Props {
  title: string;
  testimonials: Testimonial[];
}
---
<!-- Main div that wraps the testimonials section -->
<section
  class="testimonials-section mx-auto px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  id="testimonials"
>
  <!-- Title of the testimonials section -->
  <div class="mb-6 w-3/4 max-w-2xl sm:mb-10 md:mb-16 lg:w-1/2">
    <h2
      class="text-balance text-2xl font-bold text-content-text-secondary dark:text-content-text-muted sm:text-3xl lg:text-4xl"
    >
      {title}
    </h2>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <!-- Looping through each testimonial data and rendering it -->
    {
      testimonials.map((testimonial) => (
        <div class="flex h-auto">
          <div class="flex flex-col rounded-xl border border-content-border bg-content-bg-elevated shadow-sm dark:border-content-border-strong dark:bg-content-bg-elevated">
            <div class="flex-auto p-4 md:p-6">
              <!-- Testimonial content -->
              <p class="text-pretty italic text-content-text-secondary dark:text-content-text-muted whitespace-pre-line">
                {testimonial.content}
              </p>
            </div>

            <div class="rounded-b-xl border-t border-content-border bg-content-bg-subtle/80 p-4 dark:border-content-border-strong dark:bg-content-bg-strong md:px-7">
              <div class="flex items-center">
                {testimonial.footerLink ? (
                  <a 
                    href={testimonial.footerLink}
                    target="_blank"
                    rel="noopener noreferrer" 
                    class="no-hover-animation flex items-center gap-x-3"
                  >
                    <div class="flex items-center gap-x-3">
                      <AvatarTestimonialSection
                        src={testimonial.avatarSrc}
                        alt={testimonial.avatarAlt}
                      />
                      <div>
                        <div class="font-medium text-content-text-secondary dark:text-content-text-quaternary">
                          {testimonial.author}
                        </div>
                        <div class="text-content-text-secondary hover:text-magenta transition-colors duration-200 dark:text-content-text-quaternary dark:hover:text-magenta">
                          {testimonial.role}
                        </div>
                      </div>
                    </div>
                  </a>
                ) : (
                  <div class="flex items-center gap-x-3">
                    <AvatarTestimonialSection
                      src={testimonial.avatarSrc}
                      alt={testimonial.avatarAlt}
                    />
                    <div>
                      <div class="font-medium text-content-text-secondary dark:text-content-text-quaternary">
                        {testimonial.author}
                      </div>
                      <p class="text-content-text-secondary dark:text-content-text-quaternary">
                        {testimonial.role}
                      </p>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .testimonials-section {
    --testimonials-section-max-width: 85rem;
    max-width: var(--testimonials-section-max-width);
  }
</style>
