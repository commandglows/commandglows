---
import { Image } from 'astro:assets'
import product5 from '@/assets/images/CommandGlows.png'

// Define props from Astro
const { title, subTitle, benefits } = Astro.props

// Define TypeScript interface for props
interface Props {
	title: string
	subTitle?: string
	benefits?: Array<string>
}

// Define SVG marker to be used in the component
const ListItemMarker: string = `<svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mt-0.5 h-6 w-6 text-magenta dark:text-magenta flex-none"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>`
---

<section
	class="mx-auto max-w-screen-2xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14"
>
	<!-- Grid -->
	<div class="lg:grid lg:grid-cols-12 lg:items-center lg:gap-16">
		<div class="lg:col-span-7">
			<Image class="rounded-xl" src={product5} alt="Mockup of floating boxes" />
		</div>
		<div class="mt-5 sm:mt-10 lg:col-span-5 lg:mt-0">
			<div class="space-y-6 sm:space-y-8">
				<div class="space-y-2 md:space-y-4">
					<h2
						class="text-balance text-3xl font-bold text-content-text-primary dark:text-content-text-primary sm:text-4xl lg:text-5xl"
					>
						{title}
					</h2>
					{
						subTitle && (
							<p class="text-pretty text-lg text-content-text-secondary dark:text-content-text-tertiary">
								{subTitle}
							</p>
						)
					}
				</div>
				{
					benefits && (
						<ul class="space-y-2 sm:space-y-4">
							{benefits.map((item) => (
								<li class="flex space-x-3">
									<Fragment set:html={ListItemMarker} />
									<span class="text-pretty text-lg font-medium text-content-text-secondary dark:text-content-text-tertiary">
										{item}
									</span>
								</li>
							))}
						</ul>
					)
				}
			</div>
		</div>
	</div>
</section>
