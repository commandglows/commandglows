---
const userId = Astro.locals.siteAuth?.().userId ?? null
---
<div data-site-session-guard data-user-id={userId ?? ''}>
  <section data-session-recovery hidden role="alert" class="mx-auto max-w-lg px-6 py-12">
    <p>Votre connexion a changé ou ne peut pas être vérifiée. Reconnectez-vous pour continuer.</p>
    <a href="/signin" class="underline">Revenir à la connexion</a>
  </section>
</div>
<script>
  import { installSiteSessionGuard } from '@/lib/auth/siteSessionGuard'
  let dispose: (() => void) | undefined
  function mount() {
    dispose?.()
    const element = document.querySelector<HTMLElement>('[data-site-session-guard]')
    if (!element) return
    dispose = installSiteSessionGuard({ window, document, expectedUserId: element.dataset.userId || null,
      fetchSession: async signal => {
        const response = await fetch('/api/auth/session', { credentials: 'same-origin', cache: 'no-store', signal })
        if (!response.ok) throw new Error('session_unavailable')
        return response.json()
      }, reload: () => location.reload(), signIn: () => location.replace('/signin') })
  }
  document.addEventListener('astro:before-swap', () => { dispose?.(); dispose = undefined })
  document.addEventListener('astro:page-load', mount)
  mount()
</script>
