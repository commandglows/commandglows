---
/* BentoGrid — Astro wrapper with small React islands for animated widgets */
import { PluginActivityTicker } from '@components/react/landing/PluginActivityTicker'
import { KeyboardShortcutAnim } from '@components/react/landing/KeyboardShortcutAnim'
import { SmartOrgAnim } from '@components/react/landing/SmartOrgAnim'
import { getLangFromUrl } from '@/utils/i18n'

const lang = getLangFromUrl(Astro.url)

const bentoText =
  lang === 'fr'
    ? {
        sectionTitle: "Tout ce qu'il vous faut pour travailler sans friction",
        sectionSub:
          'Je développe pour les personnes avec TDAH et autisme des outils qui transforment un poste de travail éclaté en environnement stable.',
        obsiTitle: 'ObsiFlowz -- Plugins Obsidian',
        obsiDesc:
          'Gérez vos contenus avec RSSFlowz et PluginFlowz pour garder une organisation simple et durable.',
        tubeTitle: 'ReplayGlowz',
        tubeDesc:
          "Rationalisez vos recherches YouTube avec une extension Chrome pour l'annotation et la navigation par marque-pages.",
        winTitle: 'Maîtrise Windows',
        winDesc:
          "Débloquez votre environnement Windows avec une méthode d'adoption pratique et répétable.",
        blazingTitle: 'Formation structurée',
        blazingDesc:
          '8 modules pour construire un système Windows plus simple, plus net.',
        smartTitle: 'Organisation Intelligente',
        smartDesc:
          'Classez, découvrez et reprenez le contrôle de vos informations sans surcharge cognitive.',
        avgEfficiency: 'modules de formation',
      }
    : {
        sectionTitle: 'Everything you need to be productive',
        sectionSub:
          'I build tools for people with ADHD and autism to replace noisy, fragmented workflows with calmer systems.',
        obsiTitle: 'ObsiFlowz -- Obsidian Plugins',
        obsiDesc:
          'Use RSSFlowz and PluginFlowz to keep content curation reliable, searchable, and easy to maintain.',
        tubeTitle: 'ReplayGlowz',
        tubeDesc:
          'Streamline YouTube research with a Chrome extension for quick annotation and bookmark workflows.',
        winTitle: 'Windows Mastery',
        winDesc:
          'Build a practical training path for a clearer Windows system and fewer setup blocks.',
        blazingTitle: 'Structured training',
        blazingDesc: '8 practical modules to build a clearer Windows system.',
        smartTitle: 'Smart Organization',
        smartDesc:
          'Create a repeatable process to classify, retrieve, and reuse what matters.',
        avgEfficiency: 'training modules',
      }
---

<section
  id="features"
  class="landing-section bg-content-bg-secondary px-4 dark:bg-black"
>
  <div class="mx-auto max-w-6xl">
    <div class="reveal landing-section-header text-center">
      <h2
        class="landing-section-title font-display text-content-text-primary dark:text-content-text-primary text-3xl font-bold sm:text-4xl"
      >
        {bentoText.sectionTitle}
      </h2>
      <p
        class="landing-section-copy text-content-text-secondary dark:text-content-text-tertiary mx-auto max-w-2xl"
      >
        {bentoText.sectionSub}
      </p>
    </div>

    <div
      class="landing-section-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3"
    >
      <!-- Large card - ObsiFlowz -->
      <div
        class="landing-bento-card landing-surface landing-section-card reveal group hover:border-content-border dark:hover:border-content-text-secondary/50 relative overflow-hidden rounded-2xl border md:col-span-2"
      >
        <div
          class="landing-section-row flex items-start justify-between md:block"
        >
          <div class="bento-copy">
            <h3
              class="landing-bento-title text-content-text-primary dark:text-content-text-primary text-xl font-semibold"
            >
              {bentoText.obsiTitle}
            </h3>
          </div>
          <div
            class="bg-content-bg-secondary dark:bg-content-bg-secondary inline-flex shrink-0 rounded-lg p-2"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-content-text-muted dark:text-content-text-tertiary"
              ><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path
                d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg
            >
          </div>
        </div>
        <div class="landing-section-row flex flex-row items-start md:block">
          <p
            class="text-content-text-secondary dark:text-content-text-tertiary min-w-0 text-sm"
          >
            {bentoText.obsiDesc}
          </p>
          <div
            class="bento-side-anim w-1/2 max-w-48 min-w-0 shrink-0 md:w-full md:max-w-none"
          >
            <PluginActivityTicker client:only="react" />
          </div>
        </div>
        <div class="landing-bento-metrics grid grid-cols-2 sm:grid-cols-4">
          {
            ['RSSFlowz', 'PluginFlowz', 'ContentFlowz', 'NoteFlowz'].map(
              (plugin) => (
                <div class="text-center">
                  <div class="text-content-text-primary dark:text-content-text-primary text-sm font-medium">
                    {plugin}
                  </div>
                  <div class="text-content-text-muted dark:text-content-text-tertiary text-xs">
                    Active
                  </div>
                </div>
              )
            )
          }
        </div>
      </div>

      <!-- Chrome Extension -->
      <div
        class="landing-bento-card landing-surface landing-section-card reveal group hover:border-content-border dark:hover:border-content-text-secondary/50 relative rounded-2xl border delay-1"
      >
        <div
          class="landing-section-row flex items-start justify-between md:block"
        >
          <div class="bento-copy">
            <h3
              class="landing-bento-title text-content-text-primary dark:text-content-text-primary text-lg font-semibold"
            >
              {bentoText.tubeTitle}
            </h3>
          </div>
          <div
            class="bg-content-bg-secondary dark:bg-content-bg-secondary inline-flex shrink-0 rounded-lg p-2"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-content-text-muted dark:text-content-text-tertiary"
              ><circle cx="12" cy="12" r="10"></circle><circle
                cx="12"
                cy="12"
                r="4"></circle><line x1="21.17" x2="12" y1="8" y2="8"
              ></line><line x1="3.95" x2="8.54" y1="6.06" y2="14"></line><line
                x1="10.88"
                x2="15.46"
                y1="21.94"
                y2="14"></line></svg
            >
          </div>
        </div>
        <div class="landing-section-row flex flex-row items-start md:block">
          <p
            class="text-content-text-secondary dark:text-content-text-tertiary min-w-0 text-sm"
          >
            {bentoText.tubeDesc}
          </p>
          <div
            class="bento-side-anim w-1/2 max-w-48 min-w-0 shrink-0 md:w-full md:max-w-none"
          >
            <KeyboardShortcutAnim client:only="react" />
          </div>
        </div>
      </div>

      <!-- Windows Tools -->
      <div
        class="landing-bento-card landing-surface landing-section-card reveal group hover:border-content-border dark:hover:border-content-text-secondary/50 relative rounded-2xl border delay-2"
      >
        <div
          class="landing-section-row flex items-start justify-between md:block"
        >
          <div class="bento-copy">
            <h3
              class="landing-bento-title text-content-text-primary dark:text-content-text-primary text-lg font-semibold"
            >
              {bentoText.winTitle}
            </h3>
          </div>
          <div
            class="bg-content-bg-secondary dark:bg-content-bg-secondary inline-flex shrink-0 rounded-lg p-2"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-content-text-muted dark:text-content-text-tertiary"
              ><rect width="20" height="14" x="2" y="3" rx="2"></rect><line
                x1="8"
                x2="16"
                y1="21"
                y2="21"></line><line x1="12" x2="12" y1="17" y2="21"
              ></line></svg
            >
          </div>
        </div>
        <div class="landing-section-row flex flex-row items-start md:block">
          <p
            class="text-content-text-secondary dark:text-content-text-tertiary min-w-0 text-sm"
          >
            {bentoText.winDesc}
          </p>
          <svg viewBox="0 0 100 70" class="w-full sm:max-w-72">
            <defs>
              <linearGradient id="chartGradient" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="currentColor" stop-opacity="0.2"
                ></stop>
                <stop offset="100%" stop-color="currentColor" stop-opacity="0"
                ></stop>
              </linearGradient>
            </defs>
            <path
              d="M 0 60 L 20 45 L 40 55 L 60 30 L 80 40 L 100 15 L 100 70 L 0 70 Z"
              fill="url(#chartGradient)"
              class="text-content-text-primary dark:text-content-text-primary opacity-50"
            ></path>
            <path
              d="M 0 60 L 20 45 L 40 55 L 60 30 L 80 40 L 100 15"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              class="draw-line text-content-text-primary dark:text-content-text-primary"
            ></path>
          </svg>
        </div>
      </div>

      <!-- Productivity Boost -->
      <div
        class="landing-bento-card landing-surface landing-section-card reveal group hover:border-content-border dark:hover:border-content-text-secondary/50 relative rounded-2xl border delay-3"
      >
        <div
          class="landing-section-row flex items-start justify-between md:block"
        >
          <div class="bento-copy">
            <h3
              class="landing-bento-title text-content-text-primary dark:text-content-text-primary text-lg font-semibold"
            >
              {bentoText.blazingTitle}
            </h3>
          </div>
          <div
            class="bg-content-bg-secondary dark:bg-content-bg-secondary inline-flex shrink-0 rounded-lg p-2"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-content-text-muted dark:text-content-text-tertiary"
              ><path
                d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"
              ></path></svg
            >
          </div>
        </div>
        <div class="landing-section-row flex flex-row items-start md:block">
          <p
            class="text-content-text-secondary dark:text-content-text-tertiary min-w-0 text-sm"
          >
            {bentoText.blazingDesc}
          </p>
          <div
            class="bento-side-anim w-1/2 max-w-48 min-w-0 shrink-0 md:w-full md:max-w-none"
          >
            <div
              class="brand-text-green grid grid-cols-3 gap-x-3 gap-y-2 text-sm"
            >
              <div class="text-center">
                <span class="block font-mono">8</span>
                <span
                  class="text-content-text-muted dark:text-content-text-tertiary"
                  >modules</span
                >
              </div>
              <div class="text-center">
                <span class="block font-mono">2</span>
                <span
                  class="text-content-text-muted dark:text-content-text-tertiary"
                  >languages</span
                >
              </div>
              <div class="text-center">
                <span class="block font-mono">3</span>
                <span
                  class="text-content-text-muted dark:text-content-text-tertiary"
                  >core tracks</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Smart Organization -->
      <div
        class="landing-bento-card landing-surface landing-section-card reveal group hover:border-content-border dark:hover:border-content-text-secondary/50 relative overflow-hidden rounded-2xl border delay-4"
      >
        <div
          class="landing-section-row flex items-start justify-between md:block"
        >
          <div class="bento-copy">
            <h3
              class="landing-bento-title text-content-text-primary dark:text-content-text-primary text-lg font-semibold"
            >
              {bentoText.smartTitle}
            </h3>
          </div>
          <div
            class="bg-content-bg-secondary dark:bg-content-bg-secondary inline-flex shrink-0 rounded-lg p-2"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-content-text-muted dark:text-content-text-tertiary"
              ><path
                d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"
              ></path><path d="M22 10v6"></path><path
                d="M6 12.5V16c0 1 2.5 3 6 3s6-2 6-3v-3.5"></path></svg
            >
          </div>
        </div>
        <div class="landing-section-row flex flex-row items-start md:block">
          <p
            class="text-content-text-secondary dark:text-content-text-tertiary min-w-0 text-sm"
          >
            {bentoText.smartDesc}
          </p>
          <div
            class="bento-side-anim w-1/2 max-w-48 min-w-0 shrink-0 md:w-full md:max-w-none"
          >
            <SmartOrgAnim client:only="react" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
