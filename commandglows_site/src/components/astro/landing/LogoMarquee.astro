---
/* LogoMarquee — Astro wrapper with TestimonialCarousel React island */
import { TestimonialCarousel } from '@components/react/landing/TestimonialCarousel'
import { getLangFromUrl } from '@/utils/i18n'
import { getLocalizedPath } from '@/utils/routing'

interface Props {
  embedded?: boolean
}

const { embedded = false } = Astro.props
const lang = getLangFromUrl(Astro.url)

const productsUrl = getLocalizedPath(lang, 'products')
const tools = [
  { name: "ObsiFlowz", href: productsUrl + "/flowzsuite-obsidian" },
  { name: "ReplayGlowz", href: productsUrl + "/replayglowz-extension" },
  { name: "RSSFlowz", href: productsUrl + "/rssflowz-obsidian" },
  { name: "PluginFlowz", href: productsUrl + "/pluginflowz-obsidian" },
  { name: "Windows Mastery", href: getLocalizedPath(lang, 'windowsMastery') },
  { name: "Obsidian", href: "https://obsidian.md/" },
  { name: "Chrome", href: "https://www.google.com/chrome/" },
  { name: "CMDglows", href: productsUrl + "/commandglows" },
]

---

  <section
  id="testimonials"
  class:list={[
    embedded ? 'landing-testimonials--embedded scroll-mt-20 overflow-hidden' : 'landing-testimonials-shell scroll-mt-20 overflow-hidden',
    embedded ? 'bg-transparent' : 'bg-content-bg-subtle dark:bg-content-bg-inverse',
  ]}
>
  <!-- Testimonials carousel (React island) -->
  <div class="landing-testimonials-carousel max-w-3xl mx-auto px-4">
    <TestimonialCarousel client:load lang={lang} />
  </div>

  <!-- Marquee -->
  <div class="landing-testimonials-marquee relative">
    <div class="landing-marquee-fade-left pointer-events-none absolute bottom-0 left-0 top-0 z-10 w-32"></div>
    <div class="landing-marquee-fade-right pointer-events-none absolute bottom-0 right-0 top-0 z-10 w-32"></div>

    <div class="flex animate-marquee">
      {[...tools, ...tools].map((tool, index) => (
        <a
          href={tool.href}
          tabindex={index >= tools.length ? -1 : undefined}
          aria-hidden={index >= tools.length ? "true" : undefined}
          class="landing-logo-marquee-item mx-8 flex h-16 items-center justify-center grayscale opacity-50 transition-all duration-300 hover:grayscale-0 hover:opacity-100 focus-visible:opacity-100 focus-visible:ring focus-visible:ring-ring rounded-lg"
        >
          <div class="landing-badge flex items-center text-content-text-secondary dark:text-content-text-tertiary">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-content-bg-subtle dark:bg-content-bg-strong">
              <span aria-hidden="true" class="text-xs font-bold">{tool.name[0]}</span>
            </div>
            <span class="font-medium">{tool.name}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .landing-testimonials-marquee:focus-within .animate-marquee {
    animation: none;
    transform: none;
  }

  .landing-testimonials-marquee:focus-within .landing-marquee-fade-left,
  .landing-testimonials-marquee:focus-within .landing-marquee-fade-right {
    visibility: hidden;
  }

  .landing-testimonials-marquee:hover .animate-marquee,
  .landing-testimonials-marquee:focus-within .animate-marquee {
    animation-play-state: paused;
  }

  .landing-testimonials--embedded {
    padding-top: var(--landing-testimonials-embedded-padding-top);
    padding-bottom: var(--landing-testimonials-embedded-padding-bottom);
  }
</style>
