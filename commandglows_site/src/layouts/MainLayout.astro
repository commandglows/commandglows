---
// Importing necessary components
import Meta from '@/components/Meta.astro'
import Navbar from '@/components/shared/site/Navbar.astro'
import Footer from '@/components/shared/site/Footer.astro'
import SiteSessionGuard from '@/components/shared/site/SiteSessionGuard.astro'
import CookieConsent from '@components/ui/banners/CookieConsent.astro'
import { SITE } from '@/constants'
import '../assets/styles/global.css'
import { ClientRouter } from 'astro:transitions'

// Setting expected props
const { title = SITE.title, meta, structuredData, lang = 'en', noindex = false, alternateUrls, clientNavigation = true, workspace = false, navbarStatic = false, showFooter = true } = Astro.props

// Interface to type-check the properties
interface Props {
	title?: string
	meta?: {
		title?: string
		description?: string
		image?: string
		canonicalURL?: string
	}
	structuredData?: object | null
	lang?: string
	noindex?: boolean
	clientNavigation?: boolean
	workspace?: boolean
	navbarStatic?: boolean
	showFooter?: boolean
	alternateUrls?: Partial<Record<'en' | 'fr', string>>
}
---

<html lang={lang} class="scroll-pt-16 bg-content-bg dark:bg-content-bg">
	<head>
		<Meta meta={meta} title={title} lang={lang} structuredData={structuredData} noindex={noindex} alternateUrls={alternateUrls} />
		<title>{title}</title>
		<script is:inline>
			(() => {
				let storedTheme
				try { storedTheme = localStorage.getItem('hs_theme') } catch { /* System theme remains available. */ }
				const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches
					? 'dark'
					: 'light'
				const theme = storedTheme === 'dark' || storedTheme === 'light' ? storedTheme : systemTheme
				const root = document.documentElement

				root.classList.remove('dark', 'light')
				root.classList.add(theme)
				root.setAttribute('data-theme', theme)
			})()
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Audiowide&family=Manrope:wght@200..800&family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet" />
		{clientNavigation && <ClientRouter />}
	</head>
	<body id="top" class={workspace ? 'workspace-page' : 'bg-content-bg dark:bg-content-bg'}>
		<a
			href="#main-content"
			class="skip-to-content sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:left-4 focus-visible:top-4 focus-visible:rounded-md focus-visible:bg-content-bg focus-visible:px-4 focus-visible:py-2 focus-visible:text-content-text-primary focus-visible:ring-2 focus-visible:ring-navbar-ring"
		>
			{lang === 'fr' ? 'Aller au contenu principal' : 'Skip to main content'}
		</a>
		{workspace ? <slot name="navigation" /> : <Navbar static={navbarStatic} />}
  <SiteSessionGuard lang={lang === 'fr' ? 'fr' : 'en'} />
		<div class:list={['site-page-shell site-main-shell', navbarStatic && 'site-main-shell--nav-flow']}>
			<main id="main-content" tabindex="-1">
				<slot />
			</main>
			{workspace && <p data-session-checking-status hidden role="status" class="session-checking">{lang === 'fr' ? 'Vérification de votre connexion…' : 'Checking your session…'}</p>}
		</div>
		{!workspace && showFooter && <Footer />}
		<CookieConsent />
		{
			import.meta.env.PROD && (
				<script is:inline async src="https://cdn.onthe.io/io.js/YyAMWtaLLPUi" />
			)
		}
		{!workspace && <script>
		import '@/assets/scripts/preline'
		import '@/assets/scripts/lenisSmoothScroll'
		import '@/assets/scripts/modal'
		</script>}
		<script>
			import { installThemeContinuity } from '@/assets/scripts/themeContinuity'
			installThemeContinuity()
		</script>
</body>
</html>

<style>
	.site-main-shell--nav-flow {
		padding-top: 0;
	}
</style>
