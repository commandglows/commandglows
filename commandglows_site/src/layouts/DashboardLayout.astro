---
import MainLayout from '@/layouts/MainLayout.astro'
import { getNavigation } from '@/utils/fr/navigation'
import { getServerEnv } from '@/lib/serverEnv'
import { isAccountRecoveryAvailable } from '@/lib/auth/accountRecoveryAvailability'
import type { Language } from '@/types'
import ThemePicker from '@/components/ui/ThemePicker.astro'
import '@/assets/styles/dashboard.css'

interface Props {
  title: string
  currentPath: string
  lang?: Language
  alternateLanguagePath?: string | null
}

const { title, currentPath, lang = 'en', alternateLanguagePath } = Astro.props
const auth = Astro.locals.siteAuth()
const navigation = await getNavigation(lang, auth.role, {
  showNewsletter: auth.provider === 'clerk' && getServerEnv().EMAIL_ENGINE_WEB_ENABLED === 'true',
})
const recoveryAvailable = isAccountRecoveryAvailable(Astro.url.origin, auth.unavailable)
const recoveryContactUrl = lang === 'fr' ? '/fr/contact' : '/contact'
const customerNavigation = recoveryAvailable ? navigation.customer : navigation.customer.map((item) =>
  item.href === (lang === 'fr' ? '/fr/account/link-existing' : '/account/link-existing')
    ? { ...item, name: lang === 'fr' ? 'Aide pour mes achats' : 'Help with purchases', href: recoveryContactUrl }
    : item,
)
const navigationLabel =
  lang === 'fr' ? 'Navigation privée' : 'Private navigation'
const customerLabel = lang === 'fr' ? 'Mon compte' : 'My account'
const adminLabel = lang === 'fr' ? 'Administration' : 'Administration'
const normalizePath = (path: string) => path.replace(/\/$/, '') || '/'
const isCurrentPage = (href: string) =>
  normalizePath(currentPath) === normalizePath(href) ||
  (currentPath === '/dashboard/parametres' && href === '/fr/dashboard/parametres')
const alternatePath = alternateLanguagePath !== undefined ? alternateLanguagePath : /parametres|settings/.test(currentPath)
  ? lang === 'fr' ? '/dashboard/settings' : '/fr/dashboard/parametres'
  : lang === 'fr' ? '/dashboard/' : '/fr/dashboard/'
---

<MainLayout title={title} lang={lang} noindex={true} structuredData={null} workspace>
  <header slot="navigation" class="workspace-topbar" transition:name="workspace-topbar" transition:animate="none">
    <a class="workspace-wordmark" href={lang === 'fr' ? '/fr' : '/'}>Command<span>Glows</span></a>
    <span class="workspace-context">{customerLabel}</span>
    <div class="workspace-tools">
      <a class="workspace-site-link" href={lang === 'fr' ? '/fr' : '/'}>{lang === 'fr' ? 'Voir le site' : 'Visit website'} <span aria-hidden="true">↗</span></a>
      {(auth.userId || auth.unavailable) && (
        <form method="post" action="/api/auth/logout" class="workspace-logout">
          <button type="submit">{lang === 'fr' ? 'Se déconnecter' : 'Sign out'}</button>
        </form>
      )}
      {!currentPath.includes('licences') && !currentPath.includes('newsletters') && (alternatePath ? <a class="workspace-language" href={alternatePath} lang={lang === 'fr' ? 'en' : 'fr'} aria-label={lang === 'fr' ? 'Switch to English' : 'Passer en français'}>{lang === 'fr' ? 'EN' : 'FR'}</a> : <span class="text-dashboard-text-muted text-sm">{lang === 'fr' ? 'Traduction indisponible' : 'Translation unavailable'}</span>)}
      <ThemePicker />
    </div>
  </header>
  <div class="workspace-shell" data-dashboard-shell>
    <div class="workspace-grid">
      <nav
        aria-label={navigationLabel}
        class="workspace-nav"
        transition:name="workspace-navigation" transition:animate="none"
      >
        <p class="workspace-nav-label">{customerLabel}</p>
        <ul class="workspace-nav-list">
          {customerNavigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrentPage(item.href) ? 'page' : undefined}
                class="workspace-nav-link"
              >
                <Fragment set:html={item.icon} />
                <span>{item.name}</span>
              </a>
            </li>
          ))}
        </ul>
        {navigation.administration.length > 0 && (
          <div class="workspace-admin-nav">
            <p class="workspace-nav-label">{adminLabel}</p>
            <ul class="workspace-nav-list">
              {navigation.administration.map((item) => {
                const isActive = currentPath === item.href
                return (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive ? 'page' : undefined}
                      class="workspace-nav-link"
                    >
                      <Fragment set:html={item.icon} />
                      <span>{item.name}</span>
                    </a>
                  </li>
                )
              })}
            </ul>
          </div>
        )}
      </nav>

      <div class="workspace-content" transition:name="workspace-content" transition:animate="none">
        <slot />
      </div>
    </div>
  </div>
</MainLayout>
