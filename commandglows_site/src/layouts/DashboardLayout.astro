---
import MainLayout from '@/layouts/MainLayout.astro'
import { getNavigation } from '@/utils/fr/navigation'
import { getServerEnv } from '@/lib/serverEnv'
import { isAccountRecoveryAvailable } from '@/lib/auth/accountRecoveryAvailability'
import type { Language } from '@/types'

interface Props {
  title: string
  currentPath: string
  lang?: Language
}

const { title, currentPath, lang = 'en' } = Astro.props
const auth = Astro.locals.siteAuth()
const navigation = await getNavigation(lang, auth.role, {
  showNewsletter: auth.provider === 'clerk' && getServerEnv().EMAIL_ENGINE_WEB_ENABLED === 'true',
})
const recoveryAvailable = isAccountRecoveryAvailable(Astro.url.origin, auth.unavailable)
const recoveryContactUrl = lang === 'fr' ? '/fr/contact' : '/contact'
const customerNavigation = recoveryAvailable ? navigation.customer : navigation.customer.map((item) =>
  item.href === (lang === 'fr' ? '/fr/account/link-existing' : '/account/link-existing')
    ? { ...item, name: lang === 'fr' ? 'Aide pour mes achats' : 'Help with purchases', href: recoveryContactUrl }
    : item,
)
const navigationLabel =
  lang === 'fr' ? 'Navigation privée' : 'Private navigation'
const customerLabel = lang === 'fr' ? 'Mon compte' : 'My account'
const adminLabel = lang === 'fr' ? 'Administration' : 'Administration'
const normalizePath = (path: string) => path.replace(/\/$/, '') || '/'
const isCurrentPage = (href: string) =>
  normalizePath(currentPath) === normalizePath(href) ||
  (currentPath === '/dashboard/parametres' && href === '/fr/dashboard/parametres')
---

<MainLayout title={title} lang={lang} noindex={true} structuredData={null}>
  <div class="min-h-screen py-8 sm:py-12">
    <div class="mx-auto grid max-w-7xl gap-6 px-4 sm:px-6 lg:grid-cols-4 lg:gap-8 lg:px-8">
      <nav
        aria-label={navigationLabel}
        class="h-fit rounded-2xl border border-dashboard-border bg-dashboard-bg-elevated p-3 shadow-sm lg:col-span-1"
      >
        <p class="px-3 pb-2 pt-1 text-xs font-semibold uppercase tracking-wide text-dashboard-text-muted">{customerLabel}</p>
        <ul class="grid gap-1 sm:grid-cols-2 lg:grid-cols-1">
          {customerNavigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrentPage(item.href) ? 'page' : undefined}
                class:list={[
                  'focus-visible:outline-navbar-ring flex min-h-11 items-center gap-3 rounded-xl px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2',
                  isCurrentPage(item.href)
                    ? 'bg-dashboard-bg-subtle text-dashboard-text-primary'
                    : 'text-dashboard-text-muted hover:bg-dashboard-bg-hover hover:text-dashboard-text-primary',
                ]}
              >
                <Fragment set:html={item.icon} />
                <span>{item.name}</span>
              </a>
            </li>
          ))}
        </ul>
        {navigation.administration.length > 0 && (
          <div class="mt-5 border-t border-dashboard-border pt-4">
            <p class="px-3 pb-2 text-xs font-semibold uppercase tracking-wide text-dashboard-text-muted">{adminLabel}</p>
            <ul class="grid gap-1">
              {navigation.administration.map((item) => {
                const isActive = currentPath === item.href
                return (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive ? 'page' : undefined}
                      class:list={[
                        'focus-visible:outline-navbar-ring flex min-h-11 items-center gap-3 rounded-xl px-3 py-2 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2',
                        isActive
                          ? 'bg-dashboard-bg-subtle text-dashboard-text-primary'
                          : 'text-dashboard-text-muted hover:bg-dashboard-bg-hover hover:text-dashboard-text-primary',
                      ]}
                    >
                      <Fragment set:html={item.icon} />
                      <span>{item.name}</span>
                    </a>
                  </li>
                )
              })}
            </ul>
          </div>
        )}
      </nav>

      <div class="min-w-0 lg:col-span-3">
        <slot />
      </div>
    </div>
  </div>
</MainLayout>
