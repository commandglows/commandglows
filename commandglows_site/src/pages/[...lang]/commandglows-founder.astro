			<div class="mb-6">
				<p class="text-sm font-semibold uppercase tracking-widest text-magenta">
					{lang === 'fr' ? 'Conception produit' : 'Product architecture'}
				</p>
				<h2 class="mt-2 text-3xl font-bold text-content-text-primary dark:text-content-text-over-dark">{copy.productHeading}</h2>
				<p class="mt-4 max-w-3xl text-content-text-secondary dark:text-content-text-muted">{copy.productSubheading}</p>
			</div>
			<div class="grid gap-6 rounded-2xl border border-content-border bg-content-bg-elevated p-8 dark:border-content-border-strong dark:bg-content-bg-elevated">
				<h3 class="text-xl font-semibold text-content-text-primary dark:text-content-text-over-dark">{copy.workflowHeading}</h3>
				<p class="text-sm text-content-text-secondary dark:text-content-text-muted">{copy.workflowText}</p>
				<div class="grid gap-4 md:grid-cols-3">
					{copy.workflowSteps.map((item) => (
						<div class="rounded-xl border border-content-border bg-content-bg-subtle p-5 dark:border-content-border-strong dark:bg-content-bg-strong">
							<p class="mb-2 text-xs font-bold uppercase tracking-widest text-magenta">Step {item.step}</p>
							<h4 class="mb-2 text-lg font-semibold text-content-text-primary dark:text-content-text-over-dark">{item.title}</h4>
							<p class="text-sm text-content-text-secondary dark:text-content-text-muted">{item.description}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-6xl rounded-2xl border border-content-border bg-gradient-to-r from-violet-50 to-cyan-50 p-8 dark:border-content-border-strong dark:from-content-bg dark:to-content-bg">
			<div class="mb-6">
				<h2 class="text-3xl font-bold text-content-text-primary dark:text-content-text-over-dark">{copy.activationHeading}</h2>
				<p class="mt-4 max-w-3xl text-content-text-secondary dark:text-content-text-muted">{copy.activationText}</p>
			</div>
			<div class="grid gap-4 md:grid-cols-2">
				{copy.activationBullets.map((item) => (
					<div class="rounded-xl border border-content-border bg-content-bg-elevated p-4 dark:border-content-border-strong dark:bg-content-bg-strong">
						<p class="text-sm text-content-text-secondary dark:text-content-text-muted">{item}</p>
					</div>
				))}
			</div>
		</section>

		<section class="mx-auto max-w-6xl">
			<div class="mb-6">
				<p class="text-sm font-semibold uppercase tracking-widest text-magenta">
					{lang === 'fr' ? 'Architecture commerciale' : 'Commercial structure'}
				</p>
				<h2 class="mt-2 text-3xl font-bold text-content-text-primary dark:text-content-text-over-dark">{copy.tiersHeading}</h2>
				<p class="mt-4 max-w-3xl text-content-text-secondary dark:text-content-text-muted">{copy.tiersText}</p>
			</div>
			<div class="mb-6 overflow-hidden rounded-2xl border border-amber-300 bg-content-bg-inverse text-white shadow-xl shadow-black/10 dark:border-amber-400/40">
				<div class="flex flex-col gap-4 p-5 md:flex-row md:items-center md:justify-between">
					<div>
						<p class="text-xs font-bold uppercase tracking-widest text-amber-300">{copy.founderCodeLabel}</p>
						<p class="mt-1 text-lg font-semibold">{copy.founderCodeText}</p>
					</div>
					<a
						href={checkoutUrl(defaultOfferId)}
						class="inline-flex items-center justify-center rounded-xl bg-amber-300 px-5 py-3 text-sm font-bold text-content-text-primary transition-colors hover:bg-amber-200"
					>
						{copy.primaryAction}
					</a>
				</div>
			</div>
			<div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
				{copy.tiers.map((tier) => (
					<div class="relative overflow-hidden rounded-2xl border border-content-border bg-content-bg-elevated p-6 shadow-lg shadow-black/5 transition-transform hover:-translate-y-1 dark:border-content-border-strong dark:bg-content-bg-elevated">
						<div class="absolute inset-x-0 top-0 h-1 bg-gradient-rainbow-horizontal" />
						<p class="mb-2 inline-flex rounded-full border border-content-border px-3 py-1 text-xs font-semibold uppercase tracking-wider text-content-text-secondary dark:border-content-border-strong dark:text-content-text-muted">
							{tier.label}
						</p>
						<h3 class="mb-1 text-xl font-semibold text-content-text-primary dark:text-content-text-over-dark">{tier.title}</h3>
						<p class="mb-4 text-sm text-content-text-tertiary dark:text-content-text-muted">{tier.focus}</p>
						<div class="mb-5 rounded-xl bg-content-bg-subtle p-4 dark:bg-content-bg-strong">
							<div class="flex items-end gap-2">
								<span class="text-3xl font-black text-content-text-primary dark:text-white">{tier.founderPrice}</span>
								<span class="pb-1 text-sm font-semibold text-content-text-tertiary line-through dark:text-content-text-muted">{tier.price}</span>
							</div>
							<div class="mt-2 flex flex-wrap gap-2 text-xs font-semibold">
								<span class="rounded-full bg-amber-200 px-2 py-1 text-amber-950">{copy.founderPriceLabel}</span>
								<span class="rounded-full bg-white px-2 py-1 text-content-text-tertiary dark:bg-content-bg-elevated dark:text-content-text-muted">{copy.regularPriceLabel}</span>
							</div>
						</div>
						<p class="mb-4 text-sm text-content-text-secondary dark:text-content-text-muted">{tier.included}</p>
						<div class="mb-4 text-xs text-content-text-tertiary dark:text-content-text-muted">Activation: {tier.activation}</div>
						<div class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-950 dark:border-amber-400/30 dark:bg-amber-950/30 dark:text-amber-100">{tier.state}</div>
						<a
							href={checkoutUrl(tier.offerId)}
							class="mt-5 inline-flex w-full items-center justify-center rounded-xl bg-content-bg-strong px-4 py-3 text-sm font-semibold text-content-text-over-dark transition-colors hover:bg-content-bg-hover dark:bg-content-bg-elevated dark:text-content-text-primary dark:hover:bg-content-bg-hover"
						>
							{copy.primaryAction}
						</a>
					</div>
				))}
			</div>
		</section>

		<section class="mx-auto max-w-6xl rounded-2xl border border-content-border bg-content-bg-elevated px-6 py-10 dark:border-content-border-strong dark:bg-content-bg-elevated">
			<h2 class="mb-4 text-3xl font-bold text-content-text-primary dark:text-content-text-over-dark">{copy.trustHeading}</h2>
			<p class="mb-6 max-w-3xl text-content-text-secondary dark:text-content-text-muted">{copy.trustText}</p>
			<div class="grid gap-3 md:grid-cols-2">
				{copy.trustPoints.map((point) => (
					<div class="rounded-lg bg-content-bg-subtle p-4 text-sm text-content-text-secondary dark:bg-content-bg-strong dark:text-content-text-muted">
						{point}
					</div>
				))}
			</div>
		</section>

		<section class="mx-auto max-w-6xl rounded-2xl border border-content-border bg-content-bg-elevated p-6 dark:border-content-border-strong dark:bg-content-bg-elevated">
			<h2 class="mb-2 text-3xl font-bold text-content-text-primary dark:text-content-text-over-dark">{copy.faqHeading}</h2>
			<p class="mb-6 text-content-text-secondary dark:text-content-text-muted">{copy.faqText}</p>
			<div class="space-y-3">
				{copy.faqItems.map((item) => (
					<div class="rounded-xl border border-content-border bg-content-bg-subtle p-5 dark:border-content-border-strong dark:bg-content-bg-strong">
						<p class="mb-2 text-sm font-semibold text-content-text-primary dark:text-content-text-over-dark">{item.question}</p>
						<p class="text-sm text-content-text-secondary dark:text-content-text-muted">{item.answer}</p>
					</div>
				))}
			</div>
		</section>

		<section class="mx-auto max-w-6xl rounded-2xl border border-magenta/40 bg-gradient-to-r from-magenta/90 to-purple-700 p-10 text-white">
			<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
				<div class="max-w-2xl">
					<h2 class="text-3xl font-bold">{copy.finalHeading}</h2>
					<p class="mt-4 text-white/90">{copy.finalText}</p>
				</div>
				<a
					href={checkoutUrl(defaultOfferId)}
					class="inline-flex items-center rounded-xl bg-content-bg-elevated px-6 py-3 font-semibold text-content-text-primary transition-colors hover:bg-content-bg-hover"
				>
					{copy.finalAction}
				</a>
			</div>
		</section>
	</div>
	<div class="sticky bottom-4 z-20 mx-auto max-w-3xl px-4">
		<div class="rounded-2xl border border-amber-300 bg-content-bg-inverse/95 p-3 text-white shadow-2xl shadow-black/20 backdrop-blur">
			<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
				<div>
					<p class="text-xs font-bold uppercase tracking-widest text-amber-300">{copy.founderCodeLabel}</p>
					<p class="text-sm font-semibold">{copy.stickyText}</p>
				</div>
				<a
					href={checkoutUrl(defaultOfferId)}
					class="inline-flex items-center justify-center rounded-xl bg-amber-300 px-4 py-2 text-sm font-bold text-content-text-primary transition-colors hover:bg-amber-200"
				>
					{copy.primaryAction}
				</a>
			</div>
		</div>
	</div>
</MainLayout>
