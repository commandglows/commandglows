---
import MainLayout from '@/layouts/MainLayout.astro'
import type { Language } from '@/types'
import { getSafeAuthRedirectPath } from '@/utils/courseGating'
import { SignIn } from '@clerk/astro/components'

export const prerender = false

const lang = Astro.params.lang === 'fr' ? ('fr' as Language) : ('en' as Language)
const title = lang === 'fr' ? 'Connexion' : 'Sign In'
const nextUrl = Astro.url.searchParams.get('next')
const safeNextUrl = getSafeAuthRedirectPath(nextUrl)
const recoveryHref = lang === 'fr' ? '/fr/account/link-existing' : '/account/link-existing'
---

<MainLayout title={title} lang={lang}>
	<div class="flex min-h-screen items-center justify-center px-4 py-12">
		<SignIn
			routing="hash"
			fallbackRedirectUrl={safeNextUrl}
		/>
		<p class="mt-4 text-sm text-content-text-muted">
			<a class="underline" href={recoveryHref}>
				{lang === 'fr' ? 'Vous avez déjà acheté avec un autre compte ?' : 'Already purchased with another account?'}
			</a>
		</p>
	</div>
</MainLayout>
