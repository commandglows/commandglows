---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import AccountOverview from '@/components/dashboard/AccountOverview.astro'

const auth = Astro.locals.siteAuth()
if (!auth.userId && !auth.unavailable) {
  return Astro.redirect('/fr/signin')
}
if (auth.unavailable) {
  Astro.response.status = 503
  Astro.response.headers.set('Retry-After', '30')
}
---

<DashboardLayout title="Mon compte" currentPath="/fr/dashboard/" lang="fr">
  <AccountOverview auth={auth} lang="fr" />
</DashboardLayout>
