---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { UserProfile } from '@clerk/astro/components'

const auth = Astro.locals.auth()
if (!auth.userId) {
  return Astro.redirect('/signin')
}
---

<DashboardLayout
  title="Settings - Dashboard"
  currentPath="/dashboard/parametres"
>
  <div class="mx-auto max-w-4xl">
    <div class="mb-8 flex items-center gap-4">
      <a
        href="/dashboard"
        class="text-content-text-tertiary hover:text-content-text-secondary dark:text-content-text-muted dark:hover:text-content-text-muted text-sm"
      >
        &larr; Dashboard
      </a>
      <h1
        class="text-content-text-primary dark:text-content-text-primary text-3xl font-bold"
      >
        Settings
      </h1>
    </div>

    <div class="flex justify-center">
      <UserProfile routing="hash" />
    </div>
  </div>
</DashboardLayout>
