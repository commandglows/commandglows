---
import MainLayout from '@/layouts/MainLayout.astro'
import { UserProfile } from '@clerk/astro/components'

const auth = Astro.locals.auth()
if (!auth.userId) {
	return Astro.redirect('/signin')
}
---

<MainLayout title="Settings - Dashboard">
	<div class="min-h-screen py-12">
		<div class="mx-auto max-w-4xl">
			<div class="mb-8 flex items-center gap-4">
				<a href="/dashboard" class="text-sm text-content-text-tertiary hover:text-content-text-secondary dark:text-content-text-muted dark:hover:text-content-text-muted">
					&larr; Dashboard
				</a>
				<h1 class="text-3xl font-bold text-content-text-primary dark:text-content-text-primary">
					Settings
				</h1>
			</div>

			<div class="flex justify-center">
				<UserProfile routing="hash" />
			</div>
		</div>
	</div>
</MainLayout>
