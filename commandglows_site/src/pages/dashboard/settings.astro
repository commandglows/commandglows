---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import AccountSettings from '@/components/dashboard/AccountSettings.astro'

const auth = Astro.locals.siteAuth()
if (!auth.userId && !auth.unavailable) {
  return Astro.redirect('/signin?next=%2Fdashboard%2Fsettings')
}
if (auth.unavailable) {
  Astro.response.status = 503
  Astro.response.headers.set('Retry-After', '30')
}
---

<DashboardLayout title="Account settings" currentPath="/dashboard/settings" lang="en">
  <AccountSettings auth={auth} lang="en" />
</DashboardLayout>
