---
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { getCollection, render } from 'astro:content'
import { getCourseAccess, isFormationSlug } from '@/utils/courseGating'
import { getEntrySlug } from '@/utils/docs'

const requestedSlug = Astro.params.slug?.replace(/\/$/, '')
const docs = await getCollection('docs')
const entry = docs.find((doc) => {
  const slug = getEntrySlug(doc)
  const normalized = (slug === 'index' ? '' : slug).replace(/\/$/, '')
  return normalized === requestedSlug
})

if (!entry || !isFormationSlug(getEntrySlug(entry))) {
  return Astro.redirect('/404')
}

const access = await getCourseAccess(Astro)
const entrySlug = getEntrySlug(entry)
if (!access.hasAccess) {
  return Astro.redirect(`/${entrySlug}`)
}

const { Content, headings } = await render(entry)
const lang = entrySlug.startsWith('fr/') ? 'fr' : 'en'
const publicPath = `/${entrySlug}`
---

<DashboardLayout
  title={entry.data.title}
  lang={lang}
  currentPath="/dashboard/docs"
>
  <div class="mx-auto max-w-5xl">
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <span
        class="bg-green/15 tracking-eyebrow text-green ring-green/30 inline-flex rounded-full px-3 py-1 text-xs font-bold uppercase ring-1"
      >
        {lang === 'fr' ? 'Lecon debloquee' : 'Unlocked lesson'}
      </span>
      <a
        href={publicPath}
        class="dashboard-action-link brand-text-magenta text-sm hover:underline"
      >
        {lang === 'fr' ? 'Voir la version publique' : 'View public version'}
      </a>
    </div>

    <article
      class="sl-markdown-content border-content-border bg-content-bg-elevated dark:border-content-border-strong dark:bg-content-bg-elevated rounded-2xl border p-6"
    >
      {Content && <Content />}
    </article>

    {
      headings.length > 0 && (
        <div class="border-content-border bg-content-bg-subtle dark:border-content-border-strong dark:bg-content-bg-strong mt-8 rounded-2xl border p-6">
          <h2 class="text-content-text-primary dark:text-content-text-primary mb-4 text-2xl font-bold">
            {lang === 'fr' ? 'Navigation rapide' : 'Quick navigation'}
          </h2>
          <ul class="space-y-2">
            {headings
              .filter((heading) => heading.depth <= 2)
              .map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="dashboard-action-link brand-text-magenta hover:underline"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
          </ul>
        </div>
      )
    }
  </div>
</DashboardLayout>
