---
import DashboardLayout from '@/layouts/DashboardLayout.astro'

const auth = Astro.locals.auth()
if (!auth.userId) {
  return Astro.redirect('/signin')
}
---

<DashboardLayout title="Tasks - Dashboard" currentPath="/dashboard/taches">
  <div class="mx-auto max-w-4xl">
    <div class="mb-8 flex items-center gap-4">
      <a
        href="/dashboard"
        class="text-content-text-tertiary hover:text-content-text-secondary dark:text-content-text-muted dark:hover:text-content-text-muted text-sm"
      >
        &larr; Dashboard
      </a>
      <h1
        class="text-content-text-primary dark:text-content-text-primary text-3xl font-bold"
      >
        Tasks
      </h1>
    </div>

    <div
      class="border-content-border bg-content-bg-elevated dark:border-content-border-strong dark:bg-content-bg-strong rounded-xl border p-8"
    >
      <div class="mb-6 flex items-center justify-between">
        <h2
          class="text-content-text-primary dark:text-content-text-over-dark text-lg font-semibold"
        >
          My Tasks
        </h2>
      </div>

      <ul class="space-y-3" id="task-list">
        <li
          class="border-content-border dark:border-content-border-strong flex items-center gap-3 rounded-lg border p-4"
        >
          <input
            type="checkbox"
            class="border-content-border-strong text-magenta focus:ring-magenta h-5 w-5 rounded"
          />
          <span class="text-content-text-secondary dark:text-content-text-muted"
            >Explore CMDglows extensions</span
          >
        </li>
        <li
          class="border-content-border dark:border-content-border-strong flex items-center gap-3 rounded-lg border p-4"
        >
          <input
            type="checkbox"
            class="border-content-border-strong text-magenta focus:ring-magenta h-5 w-5 rounded"
          />
          <span class="text-content-text-secondary dark:text-content-text-muted"
            >Complete Windows Mastery guide</span
          >
        </li>
        <li
          class="border-content-border dark:border-content-border-strong flex items-center gap-3 rounded-lg border p-4"
        >
          <input
            type="checkbox"
            class="border-content-border-strong text-magenta focus:ring-magenta h-5 w-5 rounded"
          />
          <span class="text-content-text-secondary dark:text-content-text-muted"
            >Try ObsiFlowz plugin</span
          >
        </li>
      </ul>

      <p
        class="text-content-text-tertiary dark:text-content-text-muted mt-6 text-center text-sm"
      >
        Full task management coming soon with Convex sync.
      </p>
    </div>
  </div>
</DashboardLayout>
