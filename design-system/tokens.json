      },
      "color.keyboard.key.foreground": {
        "status": "active",
        "type": "color",
        "value": "{primitive.color.ime.key.foreground}"
      },
      "motion.keyboard.press": {
        "status": "active",
        "type": "duration",
        "value": "{primitive.duration.keyboard.press}"
      },
      "radius.email.action": {
        "status": "active",
        "type": "dimension",
        "value": "{primitive.dimension.radius.email.action}"
      },
      "space.unit": {
        "status": "active",
        "type": "dimension",
        "value": "{primitive.dimension.space.1}"
      },
      "typography.body.family": {
        "description": "Shared body-text role; physical family and fallback delivery are surface adaptations.",
        "status": "active",
        "type": "fontFamily",
        "value": "{primitive.font.body}"
      }
    }
  },
  "manifestVersion": "1.3.0",
  "product": "CommandGlows",
  "provenance": {
    "consumerContracts": [
      {
        "contract": "Site bridge imports and directly aliases the generated CSS adapter.",
        "source": "commandglows_site/src/assets/styles/global.css"
      },
      {
        "contract": "Flutter theme authority consumes the generated Dart adapter.",
        "source": "commandglows_app/lib/core/theme/commandglows_theme_tokens.dart"
      },
      {
        "contract": "Android IME bridge consumes the generated Kotlin adapter.",
        "source": "commandglows_app/android/app/src/main/kotlin/com/commandglows/app/ime/KeyboardDesignSystemMapping.kt"
      },
      {
        "contract": "Email theme consumes the generated TypeScript adapter.",
        "source": "commandglows_site/src/theme/newsletter-email-theme.ts"
      },
      {
        "contract": "Extension bridge consumes the generated isolated CSS adapter.",
        "source": "ext/src/design-system-mapping.js"
      }
    ],
    "immutableBaselines": [
      {
        "sha256": "62c7aa6c973cb2ccc055600194be26e510fe3a0a4e870a027c322d9ac93b72b2",
        "source": "design-system/inventory/cross-surface-baseline.json"
      },
      {
        "sha256": "f2296eacffc731e123b102164ea360542074dc8ff4f3897ffff6e36e231c67a2",
        "source": "design-system/inventory/site-css-custom-properties.json"
      }
    ]
  },
  "registries": {
    "adaptations": "adaptations.json",
    "deprecations": "deprecations.json",
    "exceptions": "exceptions.json"
  },
  "status": "active"
}
