{
  "$schema": "./tokens.schema.json",
  "adapters": {
    "android-ime": {
      "format": "kotlin",
      "output": "commandglows_app/android/app/src/main/kotlin/com/commandglows/app/ime/generated/CommandGlowsTokens.kt",
      "status": "active",
      "tokens": [
        "semantic.color.keyboard.key.active",
        "semantic.color.keyboard.key.foreground",
        "semantic.motion.keyboard.press",
        "semantic.space.unit"
      ]
    },
    "email": {
      "format": "typescript",
      "output": "commandglows_site/src/theme/generated/email-tokens.ts",
      "status": "active",
      "tokens": [
        "component.email.button.background",
        "component.email.button.radius",
        "semantic.space.unit",
        "semantic.typography.body.family"
      ]
    },
    "extension": {
      "format": "extension-css",
      "output": "ext/src/generated/commandglows-tokens.css",
      "status": "active",
      "tokens": [
        "primitive.color.neutral.black",
        "semantic.color.brand.logo.cyan",
        "semantic.color.brand.logo.red",
        "semantic.color.brand.website",
        "semantic.space.unit",
        "semantic.typography.body.family"
      ]
    },
    "flutter": {
      "format": "dart",
      "output": "commandglows_app/lib/core/theme/generated/commandglows_tokens.g.dart",
      "status": "active",
      "tokens": [
        "semantic.color.keyboard.key.active",
        "semantic.color.keyboard.key.foreground",
        "semantic.motion.keyboard.press",
        "semantic.space.unit",
        "semantic.typography.body.family"
      ]
    },
    "resolved-matrix": {
      "format": "resolved-json",
      "output": "design-system/resolved-values.json",
      "status": "active",
      "tokens": []
    },
    "site": {
      "format": "css",
      "output": "commandglows_site/src/assets/styles/generated/commandglows-tokens.css",
      "status": "active",
      "tokens": [
        "primitive.color.neutral.black",
        "primitive.color.neutral.white",
        "semantic.color.brand.logo.cyan",
        "semantic.color.brand.logo.green",
        "semantic.color.brand.logo.magenta",
        "semantic.color.brand.logo.red",
        "semantic.color.brand.logo.violet",
        "semantic.color.brand.logo.yellow",
        "semantic.color.brand.website",
        "semantic.space.unit",
        "semantic.typography.body.family"
      ]
    }
  },
  "description": "Structural unification of current CommandGlows token authorities without an intentional visual change.",
  "layers": {
    "component": {
      "email.button.background": {
        "type": "color",
        "value": "{semantic.color.brand.website}"
      },
      "email.button.radius": {
        "type": "dimension",
        "value": "{semantic.radius.email.action}"
      },
      "keyboard.key.active.background": {
        "type": "color",
        "value": "{semantic.color.keyboard.key.active}"
      },
      "keyboard.key.foreground": {
        "type": "color",
        "value": "{semantic.color.keyboard.key.foreground}"
      },
      "keyboard.key.press.duration": {
        "type": "duration",
        "value": "{semantic.motion.keyboard.press}"
      }
    },
    "primitive": {
      "color.app.action.dark": {
        "type": "color",
        "value": "#fcfcfc"
      },
      "color.app.action.light": {
        "type": "color",
        "value": "#262626"
      },
      "color.brand.cyan": {
        "type": "color",
        "value": "#00c8ff"
      },
      "color.brand.green": {
        "type": "color",
        "value": "#00ff44"
      },
      "color.brand.magenta": {
        "type": "color",
        "value": "#ff00c8"
      },
      "color.brand.red": {
        "type": "color",
        "value": "#ff0033"
      },
      "color.brand.violet": {
        "type": "color",
        "value": "#7c3cff"
      },
      "color.brand.yellow": {
        "type": "color",
        "value": "#ffe500"
      },
      "color.ime.key.active": {
        "type": "color",
        "value": "#17795d"
      },
      "color.ime.key.foreground": {
        "type": "color",
        "value": "#1d2320"
      },
      "color.neutral.black": {
        "type": "color",
        "value": "#000000"
      },
      "color.neutral.white": {
        "type": "color",
        "value": "#ffffff"
      },
      "dimension.radius.email.action": {
        "type": "dimension",
        "value": {
          "amount": 10,
          "unit": "px"
        }
      },
      "dimension.space.1": {
        "type": "dimension",
        "value": {
          "amount": 4,
          "unit": "px"
        }
      },
      "duration.keyboard.press": {
        "type": "duration",
        "value": {
          "amount": 170,
          "unit": "ms"
        }
      },
      "font.body": {
        "description": "Site-first canonical body stack; platforms register physical-font delivery adaptations.",
        "type": "fontFamily",
        "value": [
          "Manrope",
          "sans-serif"
        ]
      }
    },
    "semantic": {
      "color.brand.logo.cyan": {
        "status": "active",
        "type": "color",
        "value": "{primitive.color.brand.cyan}"
      },
      "color.brand.logo.green": {
        "status": "active",
        "type": "color",
        "value": "{primitive.color.brand.green}"
      },
      "color.brand.logo.magenta": {
        "status": "active",
        "type": "color",
        "value": "{primitive.color.brand.magenta}"
      },
      "color.brand.logo.red": {
        "status": "active",
        "type": "color",
        "value": "{primitive.color.brand.red}"
      },
      "color.brand.logo.violet": {
        "status": "active",
        "type": "color",
        "value": "{primitive.color.brand.violet}"
      },
      "color.brand.logo.yellow": {
        "status": "active",
        "type": "color",
        "value": "{primitive.color.brand.yellow}"
      },
      "color.brand.website": {
        "status": "active",
        "type": "color",
        "value": "{primitive.color.brand.magenta}"
      },
      "color.keyboard.key.active": {
        "status": "active",
